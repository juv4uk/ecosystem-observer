{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ecosystem Observer",
  "version": "0.1.0",
  "identifier": "org.wsm.ecosystem-observer",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "WSM Ecosystem Observer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
